# ===== Twilio (found on the https://console.twilio.com dashboard) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Your Twilio sender number, E.164 format
TWILIO_FROM_NUMBER=+15551234567

# ===== Phone(s) that receive alerts (E.164 format, comma-separated for several) =====
ALERT_TO_NUMBERS=+16171234567

# ===== Alert burst =====
SMS_COUNT=10                # messages per alert burst
SMS_INTERVAL_SECONDS=3      # seconds between messages
REALERT_MINUTES=30          # while still in stock, repeat the burst this often (0 = once per restock)

# ===== Stock check =====
CHECK_INTERVAL_SECONDS=60   # seconds between checks (minimum 15; faster risks getting blocked)
# PS5 Pro (new) = 1000050805; Certified Refurbished PS5 Pro = 1000057525 (comma-separated)
PS_SKUS=1000050805,1000057525
PS_SITE=ps-direct-us        # PlayStation Direct site code
